# ─── LUMA Backend — Environment Variables ─────────────────────────────────────
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=4000
API_PREFIX=/api

# ─── Database (Neon PostgreSQL) ───────────────────────────────────────────────
# IMPORTANT: Use TWO separate URLs for Neon:
#
#  DATABASE_URL  → Pooler endpoint (port 6543) with pgbouncer=true
#                  Used by Prisma Client at runtime. Prevents connection resets.
#  DIRECT_URL    → Direct endpoint (port 5432) without pgbouncer
#                  Used by `prisma migrate` only. Required for DDL statements.
#
# Get both from: https://console.neon.tech → Connection Details → toggle "Pooled"
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.us-east-2.aws.neon.tech/luma?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.us-east-2.aws.neon.tech/luma?sslmode=require"

# ─── JWT Auth ─────────────────────────────────────────────────────────────────
# Generate 64-char secrets: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_ME_WITH_A_64_CHAR_RANDOM_SECRET
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=REPLACE_ME_WITH_ANOTHER_64_CHAR_SECRET
JWT_REFRESH_EXPIRES_IN=30d

# ─── Google Gemini AI ─────────────────────────────────────────────────────────
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=REPLACE_ME_WITH_GEMINI_KEY

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=https://luma-reading.app,https://www.luma-reading.app,http://localhost:3000

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info
