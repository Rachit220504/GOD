# ─── LUMA Mobile — Environment Variables ──────────────────────────────────────
# Copy this file to .env and fill in real values.
# All EXPO_PUBLIC_ variables are bundled into the app build.

# ─── API ──────────────────────────────────────────────────────────────────────
# Local development:
#   EXPO_PUBLIC_API_URL=http://192.168.1.x:4000/api   ← replace x with your LAN IP
# Production:
#   EXPO_PUBLIC_API_URL=https://luma-api.onrender.com/api
EXPO_PUBLIC_API_URL=http://localhost:4000/api

# ─── App Info ─────────────────────────────────────────────────────────────────
EXPO_PUBLIC_APP_NAME=LUMA
EXPO_PUBLIC_APP_VERSION=1.0.0
